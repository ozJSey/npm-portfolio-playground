{
  "name": "npm-portfolio-playground",
  "version": "1.0.0",
  "private": true,
  "description": "Live playground for every v-* directive in this portfolio. One tab per library, every feature demoed, every demo editable in the browser.",
  "type": "module",
  "scripts": {
    "audit:npm": "pnpm audit --audit-level high",
    "build": "vite build",
    "deeplinks": "node scripts/deeplinks.mjs",
    "deeplinks:dist": "PLAYGROUND_TARGET=dist node scripts/deeplinks.mjs",
    "deps": "dependency-grouper generate",
    "dev": "vite",
    "dev:dist": "PLAYGROUND_TARGET=dist vite",
    "docs:check": "node scripts/docs.mjs",
    "docs:check:dist": "PLAYGROUND_TARGET=dist node scripts/docs.mjs",
    "docs:ci": "node scripts/docs-ci.mjs",
    "geometry": "node scripts/geometry.mjs",
    "geometry:dist": "PLAYGROUND_TARGET=dist node scripts/geometry.mjs",
    "preinstall": "dependency-grouper generate || exit 0",
    "interactions": "node scripts/interactions.mjs",
    "interactions:dist": "PLAYGROUND_TARGET=dist node scripts/interactions.mjs",
    "markdown": "node scripts/markdown.mjs",
    "modules": "node scripts/module-format.mjs",
    "preview": "vite preview",
    "refresh:npm": "node scripts/refresh-npm-packages.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:dist": "PLAYGROUND_TARGET=dist node scripts/smoke.mjs",
    "standalone": "node scripts/standalone-pages.mjs",
    "tabs": "node scripts/tabs.mjs",
    "test:npm": "node scripts/npm-e2e.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck:libs": "node scripts/typecheck-libs.mjs"
  },
  "dependencies": {
    "@ozjsey/bigdecimal-string": "1.2.2",
    "@ozjsey/dependency-grouper": "0.3.7",
    "@ozjsey/v-copy": "1.2.2",
    "@ozjsey/v-dropzone": "0.1.3",
    "@ozjsey/v-fit-children": "2.3.2",
    "@ozjsey/v-keyboard-navigation": "0.3.1",
    "@ozjsey/v-observe": "0.2.2",
    "@ozjsey/v-scroll-into-view": "1.3.3",
    "@ozjsey/v-select-text": "1.0.3",
    "@ozjsey/v-teleport-to": "1.1.4",
    "@ozjsey/vue-write-behind": "0.2.1",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/language": "^6.12.0",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.7.0",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.43.0",
    "@lezer/common": "^1.2.3",
    "@lezer/highlight": "^1.2.1",
    "@lezer/lr": "^1.4.2",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "codemirror": "^6.0.1",
    "esbuild": "^0.25.12",
    "sucrase": "^3.35.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "depGroups": [
    "portfolio-packages",
    "vue-runtime",
    "vue-app-tooling",
    "live-editor"
  ]
}
