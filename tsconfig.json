{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      // Each sibling package carries its own node_modules/vue. Without these
      // two entries TypeScript resolves `Plugin`, `Ref`, `Directive` etc. from
      // a different copy of Vue than the playground's, and every cross-package
      // type comparison fails. Mirrors `resolve.dedupe` in vite.config.ts.
      "vue": ["./node_modules/vue"],
      "vue/*": ["./node_modules/vue/*"],
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts", "scripts/**/*.mjs"]
}
